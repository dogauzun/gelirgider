# Domain Caddy issues a TLS certificate for. Set to a real hostname in
# production (Caddy gets a Let's Encrypt cert automatically). Leave as
# localhost for a local production-like run: Caddy issues a local
# self-signed cert instead, so https://localhost works but the browser
# will warn about it.
DOMAIN=localhost

# The backend's client IP (rate limits, request log) is read from
# X-Forwarded-For, trusting exactly two proxies: Caddy then nginx
# (TRUSTED_PROXY_HOPS=2 in compose.yml, not set here). Putting another proxy
# or CDN in front of Caddy needs Caddy's trusted_proxies for it and
# TRUSTED_PROXY_HOPS raised to 3 in compose.yml; see RUNBOOK.md, Logs.

# Encrypts provider API keys stored in the database; the backend refuses
# to start without it. Generate once with `openssl rand -base64 32` and keep
# it: losing it means re-entering the provider keys. To keep it out of the
# environment, use a Docker secret and SECRET_KEY_FILE instead (see the
# commented example in compose.yml, which also says to remove its
# SECRET_KEY guard); when both are set, SECRET_KEY wins.
SECRET_KEY=

# Optional. The tag compose pulls for the backend and frontend images
# (ghcr.io/dogauzun/gelirgider-*), `latest` when unset. Pin `sha-<7>` (a
# commit on main) or `vX.Y.Z` (a release tag) to stay on one version or roll
# back; see RUNBOOK.md, Rollback.
#IMAGE_TAG=
